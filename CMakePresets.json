{
  "version": 8,
  "configurePresets": [
    {
      "name": "clang-preset",
      "displayName": "Clang 22",
      "description": "Build using ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ]
}
